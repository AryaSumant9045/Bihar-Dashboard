# Server-side NewsData fetcher configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key
NEWS_DATA_API_KEY=your_newsdata_io_key

# Optional fetcher tuning
NEWS_POLL_SECONDS=3600
NEWS_MAX_ARTICLES_PER_RUN=10
NEWS_MAX_PAGES=10

# Instagram fetch worker (server-side only; never expose these in NEXT_PUBLIC_* variables)
INSTAGRAM_USERNAME=your_instagram_login
INSTAGRAM_PASSWORD=your_instagram_password
INSTAGRAM_TARGET=jansuraajofficial
INSTAGRAM_MAX_POSTS=12
# macOS app name, e.g. Google Chrome, Safari, or Arc
INSTAGRAM_BROWSER_APP=Google Chrome
# Optional Chrome profile directory, e.g. Default or Profile 2
INSTAGRAM_BROWSER_PROFILE=Default
