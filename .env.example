NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
PLUGSKY_API_KEY=
PLUGSKY_API_URL=https://api.plugsky.com/v1
PLUGSKY_MODEL=plugsky-micro

# Analysis worker defaults: one batch every 15 minutes, up to 20 items.
ANALYSIS_INTERVAL_MINUTES=15
ANALYSIS_BATCH_SIZE=20

# Set true for an always-running local Next.js server. Vercel uses vercel.json instead.
ANALYSIS_SCHEDULER_ENABLED=false
CRON_SECRET=
SUMMARY_REPROCESS_SECRET=
# Server-side NewsData fetcher configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key
NEWS_DATA_API_KEY=your_newsdata_io_key

# Optional fetcher tuning
NEWS_POLL_SECONDS=3600
NEWS_MAX_ARTICLES_PER_RUN=10
NEWS_MAX_PAGES=10

# Instagram fetch worker (server-side only; never expose these in NEXT_PUBLIC_* variables)
INSTAGRAM_USERNAME=your_instagram_login
INSTAGRAM_PASSWORD=your_instagram_password
INSTAGRAM_TARGET=jansuraajofficial
INSTAGRAM_MAX_POSTS=12
# macOS app name, e.g. Google Chrome, Safari, or Arc
INSTAGRAM_BROWSER_APP=Google Chrome
# Optional Chrome profile directory, e.g. Default or Profile 2
INSTAGRAM_BROWSER_PROFILE=Default

# ─────────────────────────────────────────────────────────────
# RSS FEEDS
# District feed URLs .env me nahi hote — wo CODE me hardcoded hain:
#   lib/districts.js  → DISTRICTS[].feed + LH_FEED_BASE
#   backend/fetchers.py → LH_FEED_BASE / LH_DISTRICT_FEED_SLUGS
# Yahan sirf wahi keys rehti hain jo legacy pipelines padhte hain:
#   HINDUSTAN_BIHAR_RSS_URL / BHASKAR_BIHAR_RSS_URL / GOOGLE_NEWS_RSS_URL
# ─────────────────────────────────────────────────────────────
HINDUSTAN_BIHAR_RSS_URL=https://api.livehindustan.com/feeds/rss/bihar/rssfeed.xml
BHASKAR_BIHAR_RSS_URL=https://www.bhaskar.com/rss-v1--category-3679.xml
GOOGLE_NEWS_RSS_URL=https://news.google.com/rss/search?q=Bihar+politics&hl=hi-IN&gl=IN&ceid=IN:hi

# ── War Room insight refresh (Vercel timeout fix ke baad ke knobs) ──────────
# Groq free tier: 8000 TPM per key. Kai keys ho to rotation hoti hai.
# GROQ_API_KEY_2=
# GROQ_API_KEYS=key1,key2
# PlugSky ab opt-in hai (ye service 500/timeout deti thi)
# PLUGSKY_ENABLED=1
# Insight route ke caps (default: model openai/gpt-oss-20b, 30 headlines, 3500 output tokens)
# INSIGHT_LLM_MODEL=openai/gpt-oss-20b
# INSIGHT_MAX_HEADLINES=30
# INSIGHT_MAX_OUTPUT_TOKENS=3500
# INSIGHT_TIME_BUDGET_MS=45000
